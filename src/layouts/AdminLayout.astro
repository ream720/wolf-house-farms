---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/cormorant-garamond/500.css';
import '../styles/global.css';
import '../styles/admin.css';
interface Props { title: string; signedIn?: boolean }
const {title,signedIn=false} = Astro.props;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
Astro.response.headers.set('Referrer-Policy','same-origin');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>{title} — WHF Admin</title><link rel="icon" href="/favicon.svg"/></head>
<body class="admin-body"><a class="skip-link" href="#main">Skip to content</a><header class="admin-header"><a class="admin-brand" href="/admin/orders/"><img src="/images/wolf-xolo.webp" width="65" height="44" alt=""/><span>WOLF HOUSE FARMS<small>Order management</small></span></a><nav aria-label="Administration"><a href="/">View site</a>{signedIn && <form method="post" action="/api/admin/logout/"><button class="text-link" type="submit">Sign out</button></form>}</nav></header><main id="main" class="admin-main"><slot/></main></body></html>
