---
interface Props { name?: 'arrow' | 'sun' | 'bag' | 'plus' | 'close'; size?: number; }
const { name = 'arrow', size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M4 12h15M13 5l7 7-7 7" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 1v2m0 18v2M1 12h2m18 0h2M4.2 4.2l1.5 1.5m12.6 12.6 1.5 1.5M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5" /></>}
  {name === 'bag' && <><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2" /></>}
  {name === 'plus' && <path d="M5 12h14M12 5v14" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
</svg>
