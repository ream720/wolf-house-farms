---
import { ui, type Locale } from '../i18n/index';
import { policyUI, POLICY_VERSION, termsSections, shippingSections, faqSections, policyPages } from '../data/policies';
import { pathFor } from '../lib/routes';
interface Props { locale: Locale; kind: typeof policyPages[number] }
const { locale, kind } = Astro.props; const p = policyUI[locale]; const t = ui(locale);
const sections = kind === 'terms' ? termsSections[locale] : kind === 'ordering' ? shippingSections[locale] : kind === 'faq' ? faqSections[locale] : [];
---
<article class="wrap policy-page" data-policy-version={POLICY_VERSION}>
  <header><p class="eyebrow">Wolf House Farms · 21+</p><h1>{p[kind]}</h1><p class="policy-updated">{p.updated}</p></header>
  <nav class="policy-nav" aria-label={locale === 'en' ? 'Policies' : 'Políticas'}>{policyPages.map(page => <a href={pathFor(locale, page)} aria-current={kind === page ? 'page' : undefined}>{p[page]}</a>)}</nav>
  {kind === 'terms' && <p class="policy-intro">{p.souvenir}</p>}
  {sections.map(section => <section class="policy-section"><h2>{section.title}</h2><p>{section.body}</p></section>)}
  {kind === 'privacy' && <section class="policy-section"><h2>{p.privacy}</h2><p>{t.privacyBody}</p><p>{locale === 'en' ? 'Your age and policy agreement is stored for this browser tab’s session. When you submit a reservation, the accepted policy version, agreement text and language are saved with the original order and its creation time. These records document your self-attestation; they do not verify age or identity.' : 'Tu declaración de edad y aceptación de políticas se guarda durante la sesión de esta pestaña. Al enviar una reserva, la versión aceptada de las políticas, el texto de aceptación y el idioma se guardan con el pedido original y su fecha de creación. Estos registros documentan tu declaración; no verifican tu edad ni identidad.'}</p></section>}
  <a class="button button-outline" href={pathFor(locale, 'home')}>{p.back}</a>
  {kind === 'terms' && <p class="policy-disclaimer">{p.disclaimer}</p>}
</article>
