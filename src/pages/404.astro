---
import SiteLayout from '../layouts/SiteLayout.astro';
import { ui } from '../i18n/index';
const t = ui('en');
---
<SiteLayout locale="en" page="home" title="Page not found"><section class="page-intro wrap info-page"><p class="eyebrow">404</p><h1>{t.notFoundTitle}</h1><p class="page-lead">{t.notFoundBody}</p><a class="button" href="/">{t.home}</a><p lang="es">Esta página no está en el archivo. <a class="text-link" href="/es/">Volver al inicio →</a></p></section></SiteLayout>
